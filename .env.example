# Required
KEEPA_API_KEY=
ANTHROPIC_API_KEY=
# Strongly recommended once deployed (protects your API keys)
APP_PASSWORD=
# Optional
# Only needed if your Anthropic key isn't scoped to a workspace (API error asks for anthropic-workspace-id)
ANTHROPIC_WORKSPACE_ID=
DISCORD_WEBHOOK_URL=
CLAUDE_MODEL=claude-sonnet-4-5
DATA_DIR=/data
MAX_CONCURRENT_RUNS=2
